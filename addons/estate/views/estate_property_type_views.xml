<?xml version="1.0"?>
<odoo>
    <!--define the record view as ir.actions.act_window-->
    <record id="estate_property_type_action" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <!--refer to the estate.property res_model defined in the model class-->
        <field name="res_model">estate.property.type</field>
        <!--view_mode as list and form-->
        <field name="view_mode">list,form</field>
     </record>

     <record id="estate_property_type_action_list" model="ir.ui.view">
         <field name="name">estate.property.type.list</field>
         <field name="model">estate.property.type</field>
         <field name="arch" type="xml">
            <list string="Channel">
                <field name="name"/>
                <field name="sequence" widget="handle"/>
            </list>
        </field>
    </record>

    <record id="estate_property_type_action_form" model="ir.ui.view">
        <field name="name">estate.property.type.form</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <form string="Estate Property Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                            <button name="%(estate_property_offer_action)d" type="action" string="View Offers"
                            class="oe_stat_button" icon="fa-list">
                            </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Properties">
                             <field name="property_ids" type="xml">
                                <list>
                                    <field name="name"/>
                                    <field name="expected_price"/>
                                    <field name="state"/>
                                </list>
                             </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_type_action_search" model="ir.ui.view">
        <field name="name">estate.property.type.search</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
                <search string="Estate Property Type">
                    <field name="name" string="Title" />
                </search>
        </field>
    </record>
</odoo>